// Cloudflare Workers config: serves the Vite build as static assets, deployed
// by .github/workflows/deploy.yml and previewed per PR by preview.yml.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bvandercar-dev",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist"
  },
  // Attaches the domain on deploy, creating its DNS record and certificate.
  "routes": [{ "pattern": "bvandercar.dev", "custom_domain": true }],
  // The live site is only on the custom domain, but each Worker Preview gets
  // a workers.dev URL; .github/workflows/preview.yml uses these.
  "workers_dev": false,
  "preview_urls": true,
  // Required by `wrangler preview`, which preview.yml runs. Empty because a
  // static site has no bindings a Preview would need kept apart from
  // production.
  "previews": {}
}
