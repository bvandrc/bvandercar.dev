{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["./conventions/biome.base.jsonc"],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "rules": {
      "correctness": {
        // wish we could use this but it doesn't work with tsconfig path aliases
        "noUndeclaredDependencies": "off"
      },
      "suspicious": {
        "noUnknownAtRules": "off"
      }
    }
  },
  "overrides": [
    {
      // A test is named for the module it covers (Link.tsx -> Link.test.tsx),
      // but exports nothing itself, so Biome can't match the name to an export.
      "includes": ["**/__tests__/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["camelCase", "kebab-case", "PascalCase"]
              }
            }
          }
        }
      }
    }
  ],
  "files": {
    "includes": [
      "**",
      "!!conventions",
      "!!**/coverage",
      "!!**/dist",
      "!!src/generated",
      // Vendored logos, kept byte for byte as published.
      "!!src/assets/icons",
      "!**/node_modules",
      "!**/playwright/results"
    ]
  }
}
